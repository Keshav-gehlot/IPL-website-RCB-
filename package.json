{
  "name": "ipl-website-(rcb)",
  "version": "1.0.0",
  "description": "Official fan website for Royal Challengers Bangalore (RCB)",
  "main": "index.js",
  "scripts": {
    "start": "serve",
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss styles/*.css -d dist/styles",
    "build:js": "terser scripts/*.js -c -m -o dist/scripts/main.min.js",
    "lint": "eslint scripts/*.js",
    "format": "prettier --write \"**/*.{js,css,html}\"",
    "test": "jest"
  },
  "keywords": [
    "rcb",
    "ipl",
    "cricket",
    "fan-website",
    "sports"
  ],
  "author": "RCB Fan Website Team",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "postcss": "^8.4.23",
    "postcss-cli": "^10.1.0",
    "prettier": "^2.8.8",
    "serve": "^14.2.0",
    "terser": "^5.18.2"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
